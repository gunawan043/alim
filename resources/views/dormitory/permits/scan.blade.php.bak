@section('script')
<script src="https://cdn.jsdelivr.net/npm/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<script>
(function() {
    'use strict';

    // ── QR Camera Scanner --}}
    let html5QrCode = null;
    const qrReader = document.getElementById('qr-reader');
    const statusEl = document.getElementById('qr-reader--status');

    function onScanSuccess(decodedText) {
        if (html5QrCode) {
            html5QrCode.stop().then(() => {
                const tokenInput = document.getElementById('manual_token');
                if (tokenInput) {
                    tokenInput.value = decodedText.trim();
                    document.getElementById('manual-tab').click();
                    statusEl.textContent = '✅ Token terdeteksi! Silakan konfirmasi aksi.';
                    statusEl.className = 'text-center text-success small';
                }
            }).catch(err => console.error('Failed to stop QR scanner:', err));
        }
    }

    function startScanner() {
        if (!qrReader) return;
        html5QrCode = new Html5Qrcode("qr-reader");
        const config = { fps: 10, qrbox: { width: 250, height: 250 }, aspectRatio: 1.0 };

        html5QrCode.start(
            { facingMode: "environment" },
            config,
            onScanSuccess,
            () => {} // ignore scan errors
        ).then(() => {
            if (statusEl) {
                statusEl.textContent = '📷 Kamera aktif. Arahkan ke QR Code izin.';
                statusEl.className = 'text-center text-muted small';
            }
        }).catch(() => {
            if (statusEl) {
                statusEl.textContent = '⚠️ Kamera tidak tersedia. Gunakan tab manual.';
                statusEl.className = 'text-center text-warning small';
            }
        });
    }

    startScanner();

    // Handle manual token scan via AJAX
    const manualForm = document.getElementById('manual-panel')?.querySelector('form');
    if (manualForm) {
        manualForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            const tokenInput = this.querySelector('input[name="token"]');
            const csrf = document.querySelector('meta[name="csrf-token"]')?.content || '';
            const resultDiv = document.getElementById('scan-result');

            if (!tokenInput || !tokenInput.value.trim()) return;

            try {
                const response = await fetch(manualForm.action, {
                    method: 'POST',
                    headers: {
                        'X-CSRF-TOKEN': csrf,
                        'Accept': 'application/json',
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: new FormData(this),
                });
                const data = await response.json().catch(() => ({ success: false }));
                if (resultDiv) {
                    if (data.success) {
                        resultDiv.innerHTML = `<div class="alert alert-success">${data.message}</div>`;
                        setTimeout(() => window.location.reload(), 2000);
                    } else {
                        resultDiv.innerHTML = `<div class="alert alert-danger">${data.error || data.message || 'Scan gagal.'}</div>`;
                    }
                }
            } catch (err) {
                if (resultDiv) {
                    resultDiv.innerHTML = '<div class="alert alert-danger">Terjadi kesalahan.</div>';
                }
            }
        });
    }

    window.addEventListener('beforeunload', () => {
        if (html5QrCode) html5QrCode.stop().catch(() => {});
    });
})();
</script>
@endsection
