APP_NAME=Alim
# Produksi: APP_ENV=production, APP_DEBUG=false, APP_URL=https://domain-anda
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# IP/CIDR reverse proxy/load balancer. Kosongkan bila tidak memakai proxy.
TRUSTED_PROXIES=
# Host header yang diizinkan (pisah koma). Kosong = host APP_URL + subdomain + localhost.
TRUSTED_HOSTS=
APP_DOMAIN=127.0.0.1
# URL logo publik untuk email. Kosongkan untuk memakai aset aplikasi.
EMAIL_LOGO_URL=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ── Supabase PostgreSQL (opsional) ─────────────────────────────────────
# Set DB_CONNECTION=supabase untuk memakai Supabase sebagai database utama.
# Gunakan connection string Session Pooler (port 5432), bukan transaction pooler 6543.
SUPABASE_DB_URL=
SUPABASE_DB_SSLMODE=require
# Alternatif bila tidak memakai URL:
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_DATABASE=postgres
SUPABASE_DB_USERNAME=
SUPABASE_DB_PASSWORD=
# Khusus migration/DDL; jangan dipakai untuk runtime aplikasi.
SUPABASE_ADMIN_DB_USERNAME=
SUPABASE_ADMIN_DB_PASSWORD=

BROADCAST_DRIVER=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=api-ap1.pusher.com
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_CLUSTER=ap1
PUSHER_APP_ID_DEMO=demo-app
PUSHER_APP_KEY_DEMO=demo-key
PUSHER_APP_SECRET_DEMO=demo-secret

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

SESSION_DRIVER=file
SESSION_LIFETIME=1200
SESSION_DOMAIN=null
# Produksi HTTPS: set true.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Development tanpa SMTP: gunakan MAIL_MAILER=log (email masuk storage/logs/laravel.log).
# Produksi: gunakan smtp dan isi kredensial di bawah.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="ALIM"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# ── Auto-Deploy Webhook ──────────────────────────────────────────
# Endpoint: POST /webhook/deploy (lihat DEPLOY-SETUP.md)
#
# DEPLOY_SECRET=
#     HMAC secret untuk validasi signature GitHub (X-Hub-Signature-256).
#     Generate: openssl rand -hex 32
#     HARUS sama dengan "Secret" di GitHub repo → Settings → Webhooks.
#
# DEPLOY_BRANCH=main
#     Branch yang akan di-deploy otomatis. Push ke branch lain diabaikan.
#
# DEPLOY_SCRIPT=/var/www/alim/deploy.sh
#     Path absolut ke deploy.sh di server.
#     Default (kosong): base_path('deploy.sh') → otomatis detect dari project root.

# ── Recruitment API (recruitment.abuhurairah.id) ───────────────────────
# Endpoint API eksternal untuk sinkronisasi dokumen & foto pelamar.
#
# RECRUITMENT_API_URL=https://recruitment.abuhurairah.id/api
#     Base URL API recruitment.
#
# RECRUITMENT_API_TOKEN=your_api_token_here
#     Bearer token untuk autentikasi ke API recruitment.

# ── Recruitment Integration API (INBOUND, dipanggil aplikasi recruitment) ──
# Aplikasi recruitment menarik data Personalia dari ALIM lewat /api/recruitment/v1/*.
# Kosong = endpoint nonaktif. Generate token: openssl rand -hex 32
#
# RECRUITMENT_INTEGRATION_KEY=your_recruitment_integration_key
# RECRUITMENT_INTEGRATION_HEADER=X-ALIM-RECRUITMENT-KEY
# RECRUITMENT_INTEGRATION_ALLOWED_IPS=
#     Whitelist IP server recruitment (kosong = semua IP). Mendukung CIDR.

# ── POS / Kasir Integration API ────────────────────────────────────────
# API key statis untuk aplikasi POS (kasir) eksternal menarik data
# satuan kerja, kepegawaian, santri, sekolah, dll dari ALIM.
# Endpoint: /api/pos/v1/* — key dikirim via header khusus di bawah.
# Kosong = integrasi nonaktif (semua request ditolak).
#
# POS_API_KEY=your_pos_api_key_here
#     Token acak panjang (min. 32 karakter). Generate:
#     openssl rand -hex 32
#
# POS_API_HEADER=X-ALIM-POS-KEY
#     Nama header pembawa token (opsional, bisa diganti).
#
# POS_ALLOWED_IPS=
#     Whitelist IP server POS, pisah koma. Kosong = semua IP boleh.
#     Mendukung CIDR, contoh: 103.10.20.30,10.0.0.0/8
#
# POS_REQUIRE_HTTPS=true
#     Tolak request non-HTTPS saat APP_ENV=production (default: true).
#
# POS_AUTH_FAIL_LIMIT=10
#     Maks. percobaan autentikasi gagal per IP per menit (default: 10).

# ── Generator Nama Arab (opsional) ─────────────────────────────
# driver: rule (kaidah transliterasi) | ai (OpenAI-compatible / lokal)
# Gratis: Ollama http://127.0.0.1:11434/v1/chat/completions (key boleh kosong)
ARABIC_NAME_DRIVER=rule
ARABIC_NAME_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
ARABIC_NAME_AI_KEY=
ARABIC_NAME_AI_MODEL=gpt-4o-mini
ARABIC_NAME_AI_TIMEOUT=20
ARABIC_NAME_AI_BATCH_LIMIT=20

# ── ALIM AI — DeepSeek API resmi (opsional) ────────────────────
# Provider juga dapat diatur lewat Super Admin > Pengaturan AI.
# Nilai ENV ini menjadi fallback jika tabel provider belum dikonfigurasi.
DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions
DEEPSEEK_API_KEY=
DEEPSEEK_FLASH_MODEL=deepseek-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
# Harga per 1 juta token (USD) untuk pencatatan biaya.
DEEPSEEK_FLASH_INPUT_PRICE=0.15
DEEPSEEK_FLASH_OUTPUT_PRICE=0.60
DEEPSEEK_PRO_INPUT_PRICE=0.60
DEEPSEEK_PRO_OUTPUT_PRICE=1.80

# ── ALIM AI — Pencarian web (opsional) ──────────────────────────
# auto: pakai Tavily/Serper/Brave bila key ada, lalu DuckDuckGo/Wikipedia gratis.
AI_WEB_SEARCH_PROVIDER=auto
AI_WEB_SEARCH_MAX_RESULTS=5
AI_CONNECT_TIMEOUT=10
AI_WEB_SEARCH_TIMEOUT=15
AI_WEB_SEARCH_CACHE_MINUTES=10
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=

# ── Arsip — pengingat backup (database + storage/app/arsip) ────
ARSIP_BACKUP_PATH=storage/app/backups
ARSIP_BACKUP_MAX_AGE_DAYS=7

# Backup asrama: salinan offsite opsional (path ter-mount/cloud sync).
BACKUP_OFFSITE_PATH=
BACKUP_KEEP=14

# Poin asrama
ASRAMA_POINT_RESET_PERIOD=yearly
ASRAMA_REWARD_CAN_OFFSET=false
ASRAMA_MAX_BEHAVIOR_REWARD=25

# ── PUSH NATIVE — FCM + APNs ───────────────────────────────────────────
# Dapat juga diatur dari Super Admin > Pengaturan Sistem > Push Mobile.
# FCM_SERVICE_ACCOUNT_JSON dapat diisi JSON mentah; atau pakai path:
# FCM_SERVICE_ACCOUNT_PATH=/path/service-account.json
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.alim.app
APNS_PRIVATE_KEY=
APNS_PRIVATE_KEY_PATH=
APNS_ENVIRONMENT=production

# Web Push VAPID (browser). Kosongkan untuk generate dari Super Admin.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=

# ── DOKUMEN RESMI & VERIFIKASI PUBLIK ───────────────────────────────
DOCUMENTS_DEFAULT_MODE=qr
DOCUMENTS_SIGNING_KEY=
DOCUMENTS_MODE_RAPOR=qr
DOCUMENTS_MODE_MUTASI=qr
DOCUMENTS_MODE_SK=qr
DOCUMENTS_VERIFY_RATE_LIMIT=30

# PAdES/PSrE — aktifkan setelah provider dan kredensial tersedia.
DOCUMENTS_PADES_ENABLED=false
DOCUMENTS_PADES_ENDPOINT=
DOCUMENTS_PADES_CLIENT_ID=
DOCUMENTS_PADES_CLIENT_SECRET=
DOCUMENTS_PADES_PROFILE=PAdES-B-T
DOCUMENTS_PADES_TSA_URL=
