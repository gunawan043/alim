APP_NAME=Alim
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://alim.example.com
APP_VERSION=1.0.0
APP_DOMAIN=alim.example.com
# Host header yang diizinkan (pisah koma). Kosong = host APP_URL + subdomain.
TRUSTED_HOSTS=

# ── PRODUCTION DB ───────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alim_prod
DB_USERNAME=alim_user
DB_PASSWORD=

# ── Supabase PostgreSQL (opsional) ─────────────────────────────────────
# Gunakan Session Pooler port 5432 untuk migration; port 6543 untuk runtime
# hanya jika prepared statement dinonaktifkan.
SUPABASE_DB_URL=
SUPABASE_DB_SSLMODE=require
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_DATABASE=postgres
SUPABASE_DB_USERNAME=
SUPABASE_DB_PASSWORD=
# Khusus migration/DDL; jangan dipakai untuk runtime aplikasi.
SUPABASE_ADMIN_DB_USERNAME=
SUPABASE_ADMIN_DB_PASSWORD=

# ── REDIS / CACHE / QUEUE ──────────────────────────────────────────────
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── CORS (React Native) ─────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://alim-app://,capacitor://localhost,http://localhost:8081

# ── AUTH & SANCTUM ────────────────────���────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=alim.example.com
SESSION_DOMAIN=.alim.example.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120

GOOGLE_ANDROID_PACKAGE_NAME=com.alim.app
GOOGLE_IOS_BUNDLE_ID=id.alim.mobile

# ── MONITORING ──────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_LARAVEL_CLIENT_ID=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── LOGGING ─────────────────────────────────────────────────────────────
LOG_CHANNEL=single
LOG_LEVEL=info

# ── MAIL ────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="ALIM"

# ── GOOGLE OAUTH ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://alim.example.com/auth/google/callback

# ── BROADCAST (Pusher/Reverb) ──────────────────────────────────────────
BROADCAST_DRIVER=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=api-ap1.pusher.com
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_CLUSTER=ap1

# ── RECRUITMENT ────────────────────────────────────────────────────────
RECRUITMENT_API_URL=https://recruitment.abuhurairah.id/api
RECRUITMENT_API_TOKEN=
# Inbound API for the recruitment app (/api/recruitment/v1/*).
RECRUITMENT_INTEGRATION_KEY=
RECRUITMENT_INTEGRATION_HEADER=X-ALIM-RECRUITMENT-KEY
RECRUITMENT_INTEGRATION_ALLOWED_IPS=

# ── POS / KASIR INTEGRATION ────────────────────────────────────────────
# Static API key for the external POS client (/api/pos/v1/*).
# Send via custom header POS_API_HEADER (default X-ALIM-POS-KEY).
# POS_ALLOWED_IPS: optional comma-separated IP/CIDR whitelist, empty = any.
POS_API_KEY=
POS_API_HEADER=X-ALIM-POS-KEY
POS_ALLOWED_IPS=

# ── DEPLOY ──────────────────────────────────────────────────────────────
DEPLOY_SECRET=
DEPLOY_BRANCH=main
DEPLOY_SCRIPT=

# ── PUSH NATIVE — FCM + APNs ───────────────────────────────────────────
# Dapat juga diatur dari Super Admin > Pengaturan Sistem > Push Mobile.
# FCM_SERVICE_ACCOUNT_JSON dapat diisi JSON mentah; atau pakai path:
# FCM_SERVICE_ACCOUNT_PATH=/path/service-account.json
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.alim.app
APNS_PRIVATE_KEY=
APNS_PRIVATE_KEY_PATH=
APNS_ENVIRONMENT=production

# Web Push VAPID (browser). Kosongkan untuk generate dari Super Admin.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
