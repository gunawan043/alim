APP_NAME=Alim
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://alim.example.com
APP_VERSION=1.0.0
APP_DOMAIN=alim.example.com

# ── PRODUCTION DB ───────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alim_prod
DB_USERNAME=alim_user
DB_PASSWORD=

# ── REDIS / CACHE / QUEUE ──────────────────────────────────────────────
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── CORS (React Native) ─────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://alim-app://,capacitor://localhost,http://localhost:8081

# ── AUTH & SANCTUM ────────────────────���────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=alim.example.com
SESSION_DOMAIN=.alim.example.com

GOOGLE_ANDROID_PACKAGE_NAME=com.alim.app
GOOGLE_IOS_BUNDLE_ID=id.alim.mobile

# ── MONITORING ──────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_LARAVEL_CLIENT_ID=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── LOGGING ─────────────────────────────────────────────────────────────
LOG_CHANNEL=single
LOG_LEVEL=info

# ── MAIL ────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="ALIM"

# ── GOOGLE OAUTH ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://alim.example.com/auth/google/callback

# ── BROADCAST (Pusher/Reverb) ──────────────────────────────────────────
BROADCAST_DRIVER=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=api-ap1.pusher.com
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_CLUSTER=ap1

# ── RECRUITMENT ────────────────────────────────────────────────────────
RECRUITMENT_API_URL=https://recruitment.abuhurairah.id/api
RECRUITMENT_API_TOKEN=

# ── DEPLOY ──────────────────────────────────────────────────────────────
DEPLOY_SECRET=
DEPLOY_BRANCH=main
DEPLOY_SCRIPT=
